# Claude Code tooling config: local to each machine, and settings.local.json
# can hold paths and grants that mean nothing anywhere else. Deliberately not
# .claude/ wholesale, so that anything shared later (agents, skills) still shows
# up in git status rather than being silently ignored.
.claude/settings.json
.claude/settings.local.json
