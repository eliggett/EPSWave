eps.lib/epsPutWSData                                     eps.lib/epsPutWSData

   NAME   
	epsPutWSData -- send wavesample data to the EPS

   SYNOPSIS
	error = epsPutWSData( eps, inst, from, to, data )

	int epsPutWSData
		( struct EPSdesc *, edit_spec *, ulong, ulong, short * );

   FUNCTION
	Send the wavesample data given in `data' to the wavesample given
	in `inst', in the range `from'-`to'.

   INPUTS
	eps		- descriptor for the EPS to send the command to.
	inst		- wavesample to send the data to.
	from		- start of data range, [0..fffff].
	to		- end of data range, [0..fffff].
	data		- pointer to an array of `short's containing the
			  wavesample data.

   RESULT
	error - zero for success, a positive number giving the last response
		returned by the EPS, or a negative number in case of library
		error.

   NOTES
	The `to' parameter actually points one past the end of the range. If
	you wanted to send the samples from 1000 to 1999 inclusive, you would
	specify `from' and `to' as 1000 and 2000, respectively.

   BUGS
	I don't know what happens if you specify an invalid range. It may
	barf, or it may extend the wavesample by the necessary amount.

   SEE ALSO
	epsGetWSData()


eps.lib/epsReplicateWSData                         eps.lib/epsReplicateWSData

   NAME   
	epsReplicateWSData -- make copies of wavesample data to fill a block

   SYNOPSIS
	error = epsReplicateWSData( eps, inst, from, to )

	int epsReplicateWSData
		( struct EPSdesc *, edit_spec *, ulong, ulong );

   FUNCTION
	Fills the wavesample given by `inst' by appending the wavesample
	data in the range `from'-`to' to itself repeatedly until it fills
	the entire sample (i.e., from `sstart_off' to `send_off' in the
	`ws_par').

   INPUTS
	eps		- descriptor for the EPS to send the command to.
	inst		- the wavesample to be replicated.
	from		- data range start, [0..fffff].
	to		- data range end, [0..fffff].

   RESULT
	error - zero for success, a positive number giving the last response
		returned by the EPS, or a negative number in case of library
		error.

   NOTES
	I'm not sure what happens if you choose a range in the middle of
	a wavesample.


eps.lib/epsReverseWSData                             eps.lib/epsReverseWSData

   NAME   
	epsReverseWSData -- reverse the wavesample data in a given range

   SYNOPSIS
	error = epsReverseWSData( eps, inst, from, to )

	int epsReverseWSData( struct EPSdesc *, edit_spec *, ulong, ulong );

   FUNCTION
	Reverse (i.e., play backward) the wavesample data of the wavesample
	given in `inst', in the range `from'-`to'.

   INPUTS
	eps		- descriptor for the EPS to send the command to.
	inst		- the wavesample to be reversed.
	from		- data range start, [0..fffff].
	to		- data range end, [0..fffff].

   RESULT
	error - zero for success, a positive number giving the last response
		returned by the EPS, or a negative number in case of library
		error.

   NOTES
	The `to' parameter actually points one past the end of the data
	range. Thus, if you wanted to reverse the samples from 1000 to 1999
	inclusive, you would specify `from' and `to' as 1000 and 2000,
	respectively.


eps.lib/epsScaleWSData                                 eps.lib/epsScaleWSData

   NAME   
	epsScaleWSData -- scale the data in a wavesample between two points

   SYNOPSIS
	error = epsScaleWSData( eps, inst, from, to, sfstart, sfs_fract,
		sfend, sfe_fract, depth )

	int epsScaleWSData( struct EPSdesc *, edit_spec *, ulong, ulong,
		int, int, int, int );

   FUNCTION
	Scale the wavesample described in `inst', in the range `from'-`to',
	based on a scaling ramp.
	`sfstart', `sfs_fract', `sfend' and `sfe_fract' give the start and
	end scale factors, as integer/fraction pairs.
	`depth' gives the scale ramp depth.

   INPUTS
	eps		- descriptor for the EPS to send the command to.
	inst		- wavesample to be scaled.
	from		- data range start.
	to		- data range end.
	sfstart		- integer part of scale factor start point, [0..127].
	sfs_fract	- fractional part of scale factor start point,
			  [0..127].
	sfend		- integer part of scale factor end point, [0..127].
	sfe_fract	- fractional part of scale factor end point,
			  [0..127].
	depth		- scale ramp depth, [0..6], 0=3.0 dB, 1=3.5 dB, ...
			  6=6.0 dB.

   RESULT
	error - zero for success, a positive number giving the last response
		returned by the EPS, or a negative number in case of library
		error.

   NOTES
	I don't understand what this does.
	Not thoroughly tested.
	The Ensoniq documentation says that `sfstart' and `sfend' are in
	the range [0..255], and that `sfs_fract' and `sfe_fract' are in the
	range [0..99]. It lies. They are all in the range [0..127].


eps.lib/epsTruncateWS                                   eps.lib/epsTruncateWS

   NAME   
	epsTruncateWS -- delete any unused data in a wavesample

   SYNOPSIS
	error = epsTruncateWS( eps, inst )

	int epsTruncateWS( struct EPSdesc *, edit_spec * );

   FUNCTION
	Truncates a wavesample, by freeing up the memory before the sample
	start and after the sample end.

   INPUTS
	eps		- descriptor for the EPS to send the command to.
	inst		- the wavesample to be truncated.

   RESULT
	error - zero for success, a positive number giving the last response
		returned by the EPS, or a negative number in case of library
		error.

   NOTES
	If the wavesample given in `inst' is a copy, this command will only
	free the memory that is not used by any of the copies. Nor will the
	EPS delete any samples that are part of a loop.


eps.lib/epsVolumeSmoothing                         eps.lib/epsVolumeSmoothing

   NAME   
	epsVolumeSmoothing -- equalize the amplitude of a wavesample range

   SYNOPSIS
	error = epsVolumeSmoothing( eps, inst, from, to, depth, smooth )

	int epsVolumeSmoothing
		( struct EPSdesc *, edit_spec *, ulong, ulong, int, int );

   FUNCTION
	Make the amplitude of the wavesample given in `inst' the same
	throughout the range `from'-`to'. The amplitude will be set to that
	at `from'. This functions like a digital dynamic compressor.

   INPUTS
	eps		- descriptor for the EPS to send the command to.
	inst		- the wavesample to be smoothened.
	from		- data range start, [0..fffff].
	to		- data range end, [0..fffff].
	depth		- scale ramp depth, [0..6], 0=3.0 dB, 1=3.5 dB, ...
			  6=6.0 dB.
	smooth		- smoothness parameter, [0..4], 0=very fine,
			  4=very coarse.

   RESULT
	error - zero for success, a positive number giving the last response
		returned by the EPS, or a negative number in case of library
		error.

   NOTES
	I'm not sure I understand all of this.


eps.lib/isleep                                                 eps.lib/isleep

   NAME   
	isleep -- do nothing for a given number of milliseconds

   SYNOPSIS
	error = isleep( eps, n )

	isleep( struct EPSdesc *, long );

   FUNCTION
	Do nothing for at least `n' milliseconds.

   INPUTS
	eps		- descriptor for the EPS that is being slept on.

   RESULT
	none

   NOTES
	Simply sets the alarm with `SetAlarm()' and waits for it to
	expire.
	The `i' doesn't stand for anything.


